{
  "name": "dsh-plugin-academic-paper",
  "version": "0.1.2",
  "description": "DeepSeek Harness 学术文献插件：arXiv / Semantic Scholar 真实数据源检索、单篇详情、GB/T 7714 / APA / BibTeX 引用格式生成、本地文献库与批量导出，杜绝模型编造文献信息",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "prepare": "pnpm run build",
    "test": "node test/run-tests.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "academic",
    "arxiv",
    "semantic-scholar",
    "citation",
    "bibtex",
    "literature"
  ],
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0-rc.7"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhaoxuejie/dsh-plugin-academic-paper.git"
  },
  "homepage": "https://github.com/zhaoxuejie/dsh-plugin-academic-paper#readme",
  "bugs": {
    "url": "https://github.com/zhaoxuejie/dsh-plugin-academic-paper/issues"
  }
}
